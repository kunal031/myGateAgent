# ---- Python ----
backend/venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Databases (regenerable via seed/ingest) ----
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---- Node / Next.js ----
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ---- Large source material (1.1 GB+; kept local, not in git) ----
# Books, PYQ papers and notes you supply. Regenerable from their origins:
# see docs/SOURCES.md for where each set came from.
books/
backend/data/documents/
backend/data/inbox/
backend/data/chroma_db/
backend/data/page_images/
backend/data/transcripts/

# Runtime state (quota counters, job progress)
backend/data/.ratelimit_*.json
backend/data/*.log

# Derived retrieval indexes — rebuildable from source_chunks via
# POST /api/agent/index/build
backend/data/vectors/

# Database dumps: ~180 MB each, and reproducible from the database itself.
backend/data/backups/

# ---- OS / editor ----
.DS_Store
*.swp
.idea/
.vscode/

# ---- Stray session file ----
:memory:.ses
