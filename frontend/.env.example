# Copy to .env.local for development.
#
# The API the browser talks to. Inlined at build time, so a change needs
# a rebuild. Use localhost for development and the deployed API URL for
# a production build.
#
#   local   http://localhost:8000
#   lambda  https://<api-id>.execute-api.<region>.amazonaws.com
#
# Note: localhost, not 127.0.0.1. The backend's CORS_ORIGINS and Google's
# authorised origins both name localhost, and browsers treat the two as
# different origins.
NEXT_PUBLIC_API_URL=http://localhost:8000
