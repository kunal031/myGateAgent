# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model roles. Override only if you know why.
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite

# Free-tier safety rails for the ingestion batch job.
# Raise these if your key is on a paid tier.
GEMINI_MAX_RPM=10
GEMINI_MAX_REQUESTS_PER_DAY=1400
GEMINI_SEARCH_MAX_PER_DAY=450

# CORS origins for the Next.js dev server
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database ----
# Which backend to use: "local" (local Postgres), "aiven" (managed, for
# deployment), or "sqlite" (the original file).
DB_TARGET=local

# Local Postgres, used for development.
POSTGRES_URL=postgresql+psycopg://kunal@localhost/gatemaster

# ---- Cache (optional) ----
# Redis, for derived values only: the syllabus tree, analytics, feed
# pages, and the shared Gemini daily-quota counter.
#
# Leave it empty and the app behaves exactly as it did before -- every
# cache miss falls through to Postgres, and the quota counter uses a
# local file. The same is true if Redis is configured but unreachable,
# so an outage costs latency and never availability.
#
# Required only if you run more than one API container: the daily quota
# counter is what two instances would otherwise each own a full copy of.
# docker-compose sets this for you.
# REDIS_URL=redis://localhost:6379/0

# Managed Postgres. Paste the provider URI as given -- a postgres:// or
# postgresql:// prefix is rewritten for psycopg automatically. Aiven
# requires TLS, so keep ?sslmode=require if the provider includes it.
POSTGRESQL_AIVEN_URI=

# Overrides everything above when set.
DATABASE_URL=

# Signs auth tokens. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- Google sign-in (optional) ----
# Leave both blank to disable it: the button hides itself and the
# email/password form keeps working.
#
# Setting it up, in the Google Cloud console:
#   1. APIs & Services > OAuth consent screen. External, add your own
#      address as a test user while it is unpublished.
#   2. Credentials > Create credentials > OAuth client ID >
#      "Web application".
#   3. Authorised redirect URIs: add GOOGLE_REDIRECT_URI below exactly as
#      written -- a trailing slash or a different scheme is a mismatch and
#      Google refuses with redirect_uri_mismatch.
#
# Only the secret is sensitive; the client ID is public by design.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the console entry byte for byte. In Docker this is the address
# a *browser* reaches, not the compose hostname.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Where the backend hands the browser back to the frontend.
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback

# ---- Neon (serverless Postgres) ----
# Use the POOLED connection string -- the hostname contains "-pooler".
# A serverless function opens a connection per invocation, and routing
# through Neon's PgBouncer is what stops concurrent Lambdas exhausting
# the compute's max_connections. The direct hostname works in testing
# and fails under load.
#
# Neon console > your project > Connection Details > "Pooled connection".
NEON_DATABASE_URL=

# Set DB_TARGET=neon to use it. Seed it from local with:
#   python -m app.cli.migrate_to_postgres --from-local \
#       --to-url "$NEON_DATABASE_URL" --replace
# Local already holds everything, embeddings included, so this is a copy
# rather than a re-ingest.

# ---- Fallback model (optional) ----
# Used only when Gemini returns 429 RESOURCE_EXHAUSTED -- a free key's
# daily budget running out. Leave blank to disable: the quota error then
# surfaces as before rather than silently doing nothing.
#
# Any OpenAI-compatible endpoint works, so switching provider is a base
# URL and a model name, not a code change:
#
#   Groq      https://api.groq.com/openai/v1      openai/gpt-oss-120b
#   Mistral   https://api.mistral.ai/v1           mistral-large-latest
#   Together  https://api.together.xyz/v1         <any chat model>
#   OpenRouter https://openrouter.ai/api/v1       <any chat model>
#
# Prefer a model with strict JSON-schema support. Card and question
# generation ask for a schema, and a model that cannot honour one
# degrades to best-effort JSON -- usable, but less reliable.
# Groq's gpt-oss and qwen3.8 support strict mode; limits are per account,
# so check console.groq.com/settings/limits rather than a blog.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL=openai/gpt-oss-120b
